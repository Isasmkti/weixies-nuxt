# Server-only payment and Supabase credentials. Never expose these with a
# `NUXT_PUBLIC_` prefix and never commit a populated `.env` file.
#
# Local development accepts the unprefixed names below. For deployed Nuxt/Nitro
# runtimes, configure the equivalent `NUXT_*` variables in the hosting provider.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_PAYOUT_WEBHOOK_TOKEN=
XENDIT_BUSINESS_ID=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Server-only Gemini credentials for AI customer service. `GEMINI_MODEL` is
# optional; the application defaults to the pinned production model below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Public canonical application origin used for trusted payment redirects.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional local debugging. Keep disabled for faster Nuxt dev startup.
NUXT_DEVTOOLS=false

# Deployment variable names:
# NUXT_XENDIT_SECRET_KEY=
# NUXT_XENDIT_WEBHOOK_TOKEN=
# NUXT_XENDIT_PAYOUT_WEBHOOK_TOKEN=
# NUXT_XENDIT_BUSINESS_ID=
# NUXT_SUPABASE_SERVICE_ROLE_KEY=
# NUXT_CRON_SECRET=
# NUXT_GEMINI_API_KEY=
# NUXT_GEMINI_MODEL=gemini-3.7-flash
# NUXT_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# NUXT_PUBLIC_SITE_URL=https://your-production-domain.example


# for vercel
NUXT_GEMINI_API_KEY=API_KEY_ANDA
NUXT_GEMINI_MODEL=gemini-3.5-flash
NUXT_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
NUXT_PUBLIC_SITE_URL=https://weixies-nuxt.vercel.app
NUXT_SUPABASE_SERVICE_ROLE_KEY=SERVICE_ROLE_KEY_ANDA
